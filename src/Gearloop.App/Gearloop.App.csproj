<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows can be added later as net10.0-windows10.0.19041.0 plus a Platforms/Windows folder. -->
    <TargetFrameworks>net10.0-maccatalyst;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gearloop.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Platform SDK and MVVM generator warnings shouldn't block a build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <ApplicationTitle>gearloop</ApplicationTitle>
    <ApplicationId>com.marcchenard.gearloop</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <!-- Mac Catalyst 17.0 is macOS 14 Sonoma, the lowest the Xcode 27 tools allow. A build made with
         the older Xcode 26.5 tools can pass -p:GearloopMacCatalystMinimum=15.0 to run on macOS 12 Monterey. -->
    <GearloopMacCatalystMinimum Condition="'$(GearloopMacCatalystMinimum)' == ''">17.0</GearloopMacCatalystMinimum>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(GearloopMacCatalystMinimum)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#000000" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#000000" BaseSize="200,200" />
    <MauiImage Include="Resources\Images\*" Exclude="Resources\Images\.gitkeep" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\.gitkeep" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gearloop.Core\Gearloop.Core.csproj" />
    <ProjectReference Include="..\Gearloop.Data\Gearloop.Data.csproj" />
  </ItemGroup>

</Project>
