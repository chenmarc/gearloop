<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Taken from the gearloop logo: cream on black. -->
    <Color x:Key="Ink">#000000</Color>
    <Color x:Key="Cream">#F5F0E3</Color>

    <Color x:Key="PageLight">#FAF8F2</Color>
    <Color x:Key="PageDark">#000000</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1C1C1E</Color>
    <Color x:Key="MutedLight">#6B6B6B</Color>
    <Color x:Key="MutedDark">#A0A0A0</Color>

    <Color x:Key="Gain">#2E7D32</Color>
    <Color x:Key="Loss">#C62828</Color>

</ResourceDictionary>
