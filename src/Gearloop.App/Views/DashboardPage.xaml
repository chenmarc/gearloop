<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gearloop.App.ViewModels"
             x:Class="Gearloop.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="720">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Profit this month" Style="{StaticResource Caption}" />
                    <Label Text="{Binding MonthProfit}" Style="{StaticResource BigNumber}" />
                    <Label Text="{Binding MonthDetail}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="This year" Style="{StaticResource Caption}" />
                        <Label Text="{Binding YearProfit}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="All time" Style="{StaticResource Caption}" />
                        <Label Text="{Binding AllTimeProfit}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Money in inventory" Style="{StaticResource Caption}" />
                    <Label Text="{Binding MoneyInInventory}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding InventoryDetail}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
