<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gearloop.App.ViewModels"
             x:Class="Gearloop.App.Views.GeneralExpensePage"
             x:DataType="vm:GeneralExpenseViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="720">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Type" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Title="Pick one" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Amount ($)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="18.50" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding Date}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Note" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Note}" Placeholder="Gas to pick up the Blues Junior" />
            </VerticalStackLayout>

            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Button Text="Delete expense" Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButton}" IsVisible="{Binding IsExisting}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
