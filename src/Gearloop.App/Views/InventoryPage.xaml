<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gearloop.App.ViewModels"
             x:Class="Gearloop.App.Views.InventoryPage"
             x:DataType="vm:InventoryViewModel"
             Title="Inventory">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Log a buy" Command="{Binding LogBuyCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="20,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8">
            <SearchBar Text="{Binding SearchText}" Placeholder="Search name, brand or category" />
            <Picker Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                    WidthRequest="110" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="Nothing here yet. Tap Log a buy to add your first piece of gear."
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center"
                       Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:InventoryRow">
                    <Border Style="{StaticResource Card}" Margin="0,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                <Label Text="{Binding Amount}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Label Text="{Binding AmountCaption}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
