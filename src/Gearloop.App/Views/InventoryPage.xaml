<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gearloop.App.ViewModels"
             x:Class="Gearloop.App.Views.InventoryPage"
             x:DataType="vm:InventoryViewModel"
             Title="Inventory">

    <CollectionView ItemsSource="{Binding Items}" Margin="20,0">
        <CollectionView.EmptyView>
            <Label Text="No gear logged yet."
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center"
                   Margin="0,40" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:InventoryRow">
                <Border Style="{StaticResource Card}" Margin="0,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                            <Label Text="{Binding Amount}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Text="{Binding AmountCaption}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
