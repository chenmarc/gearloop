<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gearloop.App.ViewModels"
             x:Class="Gearloop.App.Views.SalePage"
             x:DataType="vm:SaleViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="720">

            <Label Text="{Binding ItemName}" FontSize="20" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Sold on" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" Title="Pick one" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Date sold" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding SaleDate}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Sale price ($)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding SalePrice}" Keyboard="Numeric" Placeholder="650" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Shipping charged ($)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ShippingCharged}" Keyboard="Numeric" Placeholder="0" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Shipping you paid ($)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ShippingCost}" Keyboard="Numeric" Placeholder="0" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Fees ($)" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Fees}" Keyboard="Numeric" Placeholder="0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding FeesHint}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Reset" Command="{Binding UsePresetFeesCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,6" MinimumHeightRequest="32" FontSize="13" />
                </Grid>
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Net proceeds" />
                        <Label Grid.Column="1" Text="{Binding NetProceeds}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Profit" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Profit}" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save sale" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Button Text="Remove sale" Command="{Binding RemoveSaleCommand}"
                    Style="{StaticResource DangerButton}" IsVisible="{Binding IsExistingSale}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
